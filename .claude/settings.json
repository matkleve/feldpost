{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run verify)",
      "Bash(npm run verify:*)",
      "Bash(npm run lint:specs)",
      "Bash(npm run design-system:check)",
      "Bash(npm run i18n:check)",
      "Bash(npm run check:doc-links)",
      "Bash(node scripts/*)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/protect-paths.mjs\""
          }
        ]
      }
    ]
  }
}
